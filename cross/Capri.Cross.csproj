<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Capri</AssemblyName>
    <RootNamespace>CapriDesktop</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);CROSS</DefineConstants>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CA1416;SYSLIB0014</NoWarn>
    <Version>0.8.3</Version>
    <Product>Capri</Product>
    <ApplicationIcon>../assets/chip.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../integrations/dsh/queue.mjs" Link="queue.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../integrations/dsh/permissions.mjs" Link="dsh-permissions.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../integrations/dsh/computer.mjs" Link="computer.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../integrations/dsh/bridge.mjs" Link="dsh-bridge.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../app/Brain.cs" Link="Shared/Brain.cs" />
    <Compile Include="../app/Chess.cs" Link="Shared/Chess.cs" />
    <Compile Include="../app/ChessBoard.cs" Link="Shared/ChessGame.cs" />
    <Compile Include="../app/Care.cs" Link="Shared/Care.cs" />
    <Compile Include="../app/Engine.cs" Link="Shared/Engine.cs" />
    <Compile Include="../app/Hands.cs" Link="Shared/Hands.cs" />
    <Compile Include="../app/Presence.cs" Link="Shared/Presence.cs" />
    <Compile Include="../app/Voice.cs" Link="Shared/Voice.cs" />
    <Compile Include="../app/VoicePack.cs" Link="Shared/VoicePack.cs" />
    <EmbeddedResource Include="../assets/sprites/*.png" LogicalName="Capri.Sprite.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/voice/*.wav" LogicalName="Capri.Voice.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/chip.png" LogicalName="Capri.Chip.png" />
    <EmbeddedResource Include="../assets/cursor.png" LogicalName="Capri.Cursor.png" />
    <AvaloniaResource Include="../assets/fonts/ShareTechMono-Regular.ttf" Link="Assets/ShareTechMono-Regular.ttf" />
    <AvaloniaResource Include="../assets/fonts/Barlow*.ttf" Link="Assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/fonts/Barlow-OFL.txt" LogicalName="Capri.Font.Barlow-OFL.txt" />
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MicrophoneTarget>x86_64-apple-macosx15.0</MicrophoneTarget>
    <MicrophoneTarget Condition="'$(RuntimeIdentifier)' == 'osx-arm64' Or ('$(RuntimeIdentifier)' == '' And '$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64')">arm64-apple-macosx15.0</MicrophoneTarget>
  </PropertyGroup>
  <Target Name="BuildMicrophoneHelper" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="xcrun swiftc -O -target $(MicrophoneTarget) -module-cache-path &quot;$(IntermediateOutputPath)swift-cache&quot; &quot;$(MSBuildProjectDirectory)/mac/Microphone.swift&quot; -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker &quot;$(MSBuildProjectDirectory)/mac/Microphone.plist&quot; -o &quot;$(IntermediateOutputPath)capri-mic&quot;" />
    <Exec Command="xcrun swiftc -O -target $(MicrophoneTarget) -module-cache-path &quot;$(IntermediateOutputPath)swift-cache&quot; &quot;$(MSBuildProjectDirectory)/mac/Apps.swift&quot; -o &quot;$(IntermediateOutputPath)capri-apps&quot;" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)capri-mic" Link="capri-mic" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="$(IntermediateOutputPath)capri-apps" Link="capri-apps" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
